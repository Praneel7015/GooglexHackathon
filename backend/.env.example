# Supabase (PostgreSQL + PostGIS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Qdrant Cloud (Vector DB)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Twitter API v2 (OAuth 1.0a — all 4 keys needed to post tweets)
# Get from developer.twitter.com — apply for free tier
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

# Gmail (NammaCity's complaints address)
# Generate App Password at myaccount.google.com/apppasswords
# (NOT your regular password — must enable 2FA first)
GMAIL_USER=complaints@nammacity.in
GMAIL_APP_PASSWORD=your-16-char-app-password

# WhatsApp — Stubbed for hackathon, no env vars needed

# Environment
ENVIRONMENT=dev
